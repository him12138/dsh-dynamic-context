{
    "name":  "dsh-memory",
    "version":  "0.1.0",
    "description":  "项目级动态上下文记忆：固定记忆文档 + 任务卡片 + 检索/展开/原话",
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "node run-tests.mjs",
                    "test:build":  "npm run build \u0026\u0026 npm test"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "engines":  {
                    "node":  "^22.19.0 || \u003e=24.0.0",
                    "dsh":  "\u003e=0.2.1-rc.3"
                },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "~4.0.5",
                             "@deepseek-ai/dsh-system-prompt":  "0.2.1-rc.5",
                             "@deepseek-ai/dsh-tools":  "0.2.1-rc.5",
                             "@deepseek-ai/dsh-commands":  "0.2.1-rc.5",
                             "@deepseek-ai/dsh-session-query":  "0.2.1-rc.5",
                             "@deepseek-ai/dsh-session":  "0.2.1-rc.5"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/cordis":  {
                                                             "optional":  true
                                                         },
                                 "@deepseek-ai/dsh-system-prompt":  {
                                                                        "optional":  true
                                                                    },
                                 "@deepseek-ai/dsh-tools":  {
                                                                "optional":  true
                                                            },
                                 "@deepseek-ai/dsh-commands":  {
                                                                   "optional":  true
                                                               },
                                 "@deepseek-ai/dsh-session-query":  {
                                                                        "optional":  true
                                                                    },
                                 "@deepseek-ai/dsh-session":  {
                                                                  "optional":  true
                                                              }
                             },
    "devDependencies":  {
                            "typescript":  "^5.6.0",
                            "@types/node":  "^24.0.0"
                        },
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "dsh-plugin",
                     "memory",
                     "context"
                 ],
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/him12138/dsh-memory.git"
                   },
    "homepage":  "https://github.com/him12138/dsh-memory#readme",
    "bugs":  {
                 "url":  "https://github.com/him12138/dsh-memory/issues"
             },
    "author":  "him12138"
}
